{
  "manifest_version": 3,
  "name": "TotalCounts - Ingreso SRI e IESS",
  "version": "1.2.0",
  "description": "Abre los portales SRI e IESS y rellena las credenciales del cliente seleccionado.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://totalcounts.com.ec/*",
    "https://srienlinea.sri.gob.ec/*",
    "https://www.iess.gob.ec/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://totalcounts.com.ec/totalcounts/*"
      ],
      "js": [
        "content-totalcounts.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ],
      "js": [
        "content-sri.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.iess.gob.ec/empleador-web/*"
      ],
      "js": [
        "content-iess.js"
      ],
      "run_at": "document_idle"
    }
  ]
}